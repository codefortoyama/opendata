{
  "name": "codetoyama-open-data",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "version": "1.0.0",
  "description": "Code for Toyama - Open Data Link Collection Site",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/security.test.mjs",
    "test:build-security": "node --test tests/csp-build.test.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/qrcode": "^1.5.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
