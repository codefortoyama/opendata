---
import Base from '../layouts/Base.astro';
import appsData from '../data/apps.json';
import QRCode from 'qrcode';
import { validateApps, scriptJson } from '../scripts/data';

const apps = validateApps(appsData);

const qrByUrl: Record<string, string> = {};
for (const app of apps) {
  qrByUrl[app.url] = await QRCode.toDataURL(app.url, { width: 96, margin: 1 });
}
---

<Base title="Code for Toyama - Open Data">
  <div class="container">
    <header class="hero">
      <img
        class="hero-image"
        src={`${import.meta.env.BASE_URL}images/toyama-opendata-eyecatch.png`}
        alt="立山連峰と富山湾、街並みと路面電車にデータのつながりを重ねたイラスト"
        width="1672"
        height="941"
        loading="eager"
        fetchpriority="high"
      />
      <div class="inner">
        <div class="logo">
          <h1>Code for Toyama</h1>
        </div>
        <p class="subtitle">オープンデータ活用サイト・アプリ リンク集</p>
      </div>
    </header>

    <nav class="section-nav">
      <button class="menu-toggle" aria-label="メニュー" aria-expanded="false">☰</button>
      <a href="#prefectural" class="nav-link">県・市町村 公式データ</a>
      <a href="#codetoyama" class="nav-link">活用サイト・アプリ</a>
      <a href="#about" class="nav-link">このサイトについて</a>
    </nav>

    <main>
      <!-- セクション1: 公式データ（静的表示） -->
      <section id="prefectural" class="section fade-in fade-in-delay-1">
        <h2 class="section-title">
          <span class="badge">1</span>
          富山県内のオープンデータサイト
        </h2>
        <p class="section-desc">富山県や市町村が公開しているオープンデータポータルサイト</p>
        <div class="link-grid">
          <a href="https://ckan-front.tdcp.pref.toyama.jp/" class="card card--link" target="_blank" rel="noopener">
            <h3>富山県／富山データ連携基盤</h3>
            <p>令和6年度より運用開始された県内のオープンデータ一元提供プラットフォーム</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://opdt.city.toyama.lg.jp/" class="card card--link" target="_blank" rel="noopener">
            <h3>富山市オープンデータサイト</h3>
            <p>富山市が運営するデータカタログサイト</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://www.city.takaoka.toyama.jp/soshiki/johoseisakuka/2/3/1/1/index.html" class="card card--link" target="_blank" rel="noopener">
            <h3>高岡市 オープンデータ</h3>
            <p>高岡市の公共施設・人口・防災等のデータカタログ</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://www.city.uozu.toyama.jp/guide/svGuideDtl.aspx?servno=13031" class="card card--link" target="_blank" rel="noopener">
            <h3>魚津市 オープンデータ</h3>
            <p>魚津市が保有する統計資料や施設情報などのデータ</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://www.city.himi.toyama.jp/gyosei/soshiki/somu/5/10101.html" class="card card--link" target="_blank" rel="noopener">
            <h3>氷見市 統計・データ</h3>
            <p>氷見市の各種統計データおよび公開情報</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://www.city.namerikawa.toyama.jp/soshiki/dx/opendata/index.html" class="card card--link" target="_blank" rel="noopener">
            <h3>滑川市 オープンデータ</h3>
            <p>滑川市の行政データ・統計情報のカタログ</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://www.city.kurobe.toyama.jp/category/page.aspx?servno=10951" class="card card--link" target="_blank" rel="noopener">
            <h3>黒部市 オープンデータ</h3>
            <p>黒部市が公開する二次利用可能な公的データ</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://www.city.tonami.lg.jp/info/4061p/#gsc.tab=0" class="card card--link" target="_blank" rel="noopener">
            <h3>砺波市 オープンデータ</h3>
            <p>砺波市が提供する公共施設情報などのデータ集</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://www.city.oyabe.toyama.jp/shiseijyouhou/1001969/1003260.html" class="card card--link" target="_blank" rel="noopener">
            <h3>小矢部市 オープンデータ</h3>
            <p>小矢部市の統計・施設・防災などの公開データ</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://www.city.nanto.toyama.jp/1909.html" class="card card--link" target="_blank" rel="noopener">
            <h3>南砺市 オープンデータ</h3>
            <p>南砺市が提供する各種統計・行政データ</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://opendata.city.imizu.toyama.jp/" class="card card--link" target="_blank" rel="noopener">
            <h3>射水市 オープンデータ</h3>
            <p>射水市の避難所、人口統計等のデータ提供</p>
            <span class="arrow">→</span>
          </a>
          <a href="https://ckan-front.tdcp.pref.toyama.jp/organization" class="card card--link" target="_blank" rel="noopener">
            <h3>その他 町・村データ</h3>
            <p>上市町・立山町・入善町・朝日町・舟橋村のデータ（連携基盤内）</p>
            <span class="arrow">→</span>
          </a>
        </div>
      </section>

      <!-- セクション2: 活用サイト・アプリ（動的表示） -->
      <section id="codetoyama" class="section fade-in fade-in-delay-2">
        <h2 class="section-title">
          <span class="badge">2</span>
          オープンデータを活用したサイト・アプリ
        </h2>

        <div class="search-box">
          <input
            type="search"
            id="search-input"
            class="search-input"
            placeholder="アプリ名・カテゴリ・説明で検索..."
            aria-label="アプリを検索"
          >
          <div class="search-meta">
            <span class="search-results-count" aria-live="polite"></span>
          </div>
        </div>

        <div class="link-grid" id="apps-grid">
          <!-- JSでレンダリング -->
        </div>

        <nav class="pagination" id="pagination" aria-label="ページネーション">
          <!-- JSでレンダリング -->
        </nav>
      </section>

      <section id="about" class="section fade-in fade-in-delay-3">
        <h2 class="section-title">
          <span class="badge">3</span>
          このサイトについて
        </h2>
        <div class="about-content">
          <p>
            このサイトは Code for Toyama が運営する、富山県内のオープンデータ活用サイトのリンク集です。
          </p>
          <div class="social-links">
            <a href="https://github.com/codefortoyama" class="btn" target="_blank" rel="noopener">
              GitHub
            </a>
            <a href="https://codefortoyama.github.io/" class="btn btn-primary" target="_blank" rel="noopener">
              公式サイト
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-links">
        <a href="#prefectural">県・市町村 公式データ</a>
        <a href="#codetoyama">活用サイト・アプリ</a>
        <a href="#about">このサイトについて</a>
        <a href="#" data-cookie-settings>Cookie設定</a>
      </div>
      <p>&copy; 2026 Code for Toyama. All rights reserved.</p>
      <p class="footer-meta">Code for Toyama · 富山県オープンデータ活用サイト</p>
    </footer>
  </div>
</Base>

<script is:inline type="application/json" id="apps-qr" set:html={scriptJson(qrByUrl)}></script>

<script>
  import { init } from '../scripts/apps';
  import appsData from '../data/apps.json';
  import type { OpenDataApp } from '../types';

  const apps = appsData as OpenDataApp[];

  const qrEl = document.getElementById('apps-qr');
  const qrByUrl: Record<string, string> = qrEl?.textContent ? JSON.parse(qrEl.textContent) : {};
  init(apps, qrByUrl);

  // Fade In Animation
  const fadeElements = document.querySelectorAll('.fade-in');
  const fadeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          fadeObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );
  fadeElements.forEach((el) => fadeObserver.observe(el));

  // Mobile Menu Toggle
  const menuToggle = document.querySelector('.menu-toggle');
  const sectionNav = document.querySelector('.section-nav');

  if (menuToggle && sectionNav) {
    menuToggle.addEventListener('click', () => {
      const isOpen = sectionNav.classList.toggle('nav-open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.textContent = isOpen ? '✕' : '☰';
    });
  }

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = (link as HTMLAnchorElement).getAttribute('href');
      if (href && href !== '#') {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (sectionNav) sectionNav.classList.remove('nav-open');
        if (menuToggle) {
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.textContent = '☰';
        }
      }
    });
  });

  // To Top Button
  const toTop = document.createElement('button');
  toTop.className = 'to-top';
  toTop.setAttribute('aria-label', 'ページ上部へ戻る');
  toTop.textContent = '↑';
  toTop.setAttribute('type', 'button');
  document.body.appendChild(toTop);

  toTop.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      toTop.classList.add('visible');
    } else {
      toTop.classList.remove('visible');
    }
  });

  // Active nav link on scroll
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  const navObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove('active'));
          const activeLink = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
          activeLink?.classList.add('active');
        }
      });
    },
    { threshold: 0.3 }
  );
  sections.forEach((section) => navObserver.observe(section));
</script>
