---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Code for Toyama が運営するオープンデータ活用サイト・アプリのリンク集" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Code for Toyama が運営するオープンデータ活用サイト・アプリのリンク集" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>