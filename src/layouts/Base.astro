---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Code for Toyama が運営するオープンデータ活用サイト・アプリのリンク集" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Code for Toyama が運営するオープンデータ活用サイト・アプリのリンク集" />
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0SFK86LPGH"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0SFK86LPGH', { 'analytics_storage': 'denied', 'ad_storage': 'denied' });
    </script>
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>