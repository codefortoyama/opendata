---
const base = import.meta.env.BASE_URL;
const policyHref = `${base}cookie-policy/`;
---
<div id="cookie-consent" class="cookie-consent" role="alertdialog" aria-labelledby="cookie-heading" aria-modal="true">
  <p id="cookie-heading">
    このウェブサイトはクッキーを使用しています。
    <a href={policyHref}>クッキーポリシー</a>をご確認ください。
  </p>
  <div class="cookie-actions">
    <button id="cookie-accept">同意する</button>
    <button id="cookie-reject">拒否</button>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    max-width: 720px;
    margin-inline: auto;
    background: var(--c-surface, #fff);
    color: var(--c-text, #13232b);
    border: 1px solid var(--c-border, #dce7ea);
    border-radius: var(--radius, 16px);
    padding: 1.25rem 1.5rem;
    z-index: 1000;
    box-shadow: var(--shadow-lg, 0 18px 40px rgba(16, 42, 48, 0.14));
    display: none;
  }
  .cookie-consent.show {
    display: block;
    animation: cookie-in 0.3s ease;
  }
  @keyframes cookie-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  .cookie-consent p {
    margin-bottom: 0.9rem;
    font-size: 0.9rem;
  }
  .cookie-consent a {
    color: var(--c-primary, #0d7a72);
    text-decoration: underline;
  }
  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cookie-consent button {
    padding: 0.65rem 1.5rem;
    border: none;
    border-radius: var(--radius-pill, 999px);
    cursor: pointer;
    font-size: 0.9rem;
    font-family: inherit;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .cookie-consent button:hover {
    transform: translateY(-2px);
  }
  #cookie-accept {
    color: #fff;
    background: linear-gradient(135deg, var(--c-primary, #0d7a72), var(--c-primary-strong, #0a5b55));
    box-shadow: 0 4px 12px rgba(13, 122, 114, 0.3);
  }
  #cookie-accept:hover {
    box-shadow: 0 6px 20px rgba(13, 122, 114, 0.45);
  }
  #cookie-reject {
    color: var(--c-text, #13232b);
    background: var(--c-surface-2, #eef4f6);
    border: 1px solid var(--c-border, #dce7ea);
  }
  #cookie-reject:hover {
    border-color: var(--c-primary, #0d7a72);
  }
  @media (prefers-reduced-motion: reduce) {
    .cookie-consent.show { animation: none; }
    .cookie-consent button:hover { transform: none; }
  }
</style>

<script>
  import { initConsent } from '../scripts/consent';
  initConsent(import.meta.env.BASE_URL);
</script>
